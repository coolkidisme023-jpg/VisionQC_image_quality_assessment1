# Copy this file to .env and adjust as needed. VisionQC never requires an
# API key or secret of any kind - every setting below is plain
# configuration (URLs, paths, limits), never a credential.

# --- Backend --------------------------------------------------------------

# Comma-separated list of origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite database file lives. Defaults to <repo>/data/visionqc.db.
# VISIONQC_DATABASE_PATH=./data/visionqc.db

# Where the trained model + metadata live. Defaults to <repo>/models.
# VISIONQC_MODELS_DIR=./models

# Max upload size in bytes. Defaults to 10 MB.
# VISIONQC_MAX_UPLOAD_BYTES=10485760

# VISIONQC_HOST=0.0.0.0
# VISIONQC_PORT=8000
# VISIONQC_DEBUG=false

# --- Frontend ---------------------------------------------------------------

# URL the browser uses to reach the backend API. Must be reachable from
# wherever the person's browser runs (not a Docker-internal service name).
VITE_API_URL=http://localhost:8000
